    {
      "blueprint_id": "bp-7d8dab2da719",
      "blueprint_name": "KMS Key",
      "config": {
        "key_statements": [
          {
            "actions": [
              "kms:Encrypt",
              "kms:Decrypt",
              "kms:ReEncrypt*",
              "kms:GenerateDataKey*",
              "kms:DescribeKey"
            ],
            "principals": [
              {
                "identifiers": [
                  "dynamodb.amazonaws.com",
                  "ec2.amazonaws.com",
                  "ecr.amazonaws.com",
                  "eks.amazonaws.com",
                  "elasticache.amazonaws.com",
                  "logs.us-east-1.amazonaws.com",
                  "redshift.amazonaws.com"
                ],
                "type": "Service"
              }
            ],
            "resources": [
              "*"
            ],
            "sid": "ArchieAllowServiceUse"
          },
          {
            "actions": [
              "kms:CreateGrant",
              "kms:ListGrants",
              "kms:RevokeGrant"
            ],
            "condition": [
              {
                "test": "Bool",
                "values": [
                  "true"
                ],
                "variable": "kms:GrantIsForAWSResource"
              }
            ],
            "principals": [
              {
                "identifiers": [
                  "ecr.amazonaws.com",
                  "eks.amazonaws.com",
                  "elasticache.amazonaws.com",
                  "logs.us-east-1.amazonaws.com",
                  "redshift.amazonaws.com"
                ],
                "type": "Service"
              }
            ],
            "resources": [
              "*"
            ],
            "sid": "ArchieAllowServiceGrants"
          }
        ]
      },
      "id": "kms",
      "state_key_hint": "tf-native-state/<tenant>/<app>-kms-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-02e4e29186d5",
      "blueprint_name": "Dynamodb Table",
      "config": {
        "attributes": [
          {
            "name": "pk",
            "type": "S"
          }
        ],
        "hash_key": "pk",
        "point_in_time_recovery_enabled": true,
        "server_side_encryption_enabled": true,
        "server_side_encryption_kms_key_arn": "${kms.key_arn}"
      },
      "id": "dynamodb",
      "state_key_hint": "tf-native-state/<tenant>/<app>-dynamodb-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-15b4e7496b5f",
      "blueprint_name": "ECR Repository",
      "config": {
        "repository_encryption_type": "KMS",
        "repository_kms_key": "${kms.key_arn}",
        "repository_lifecycle_policy": "<redacted>"
      },
      "id": "ecr",
      "state_key_hint": "tf-native-state/<tenant>/<app>-ecr-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-b2883e676f5a",
      "blueprint_name": "VPC",
      "config": {
        "enable_nat_gateway": true,
        "private_subnet_tags": {
          "kubernetes.io/role/internal-elb": "1"
        },
        "public_subnet_tags": {
          "kubernetes.io/role/elb": "1"
        },
        "single_nat_gateway": true
      },
      "id": "vpc",
      "state_key_hint": "tf-native-state/<tenant>/<app>-vpc-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-be8c1899f490",
      "blueprint_name": "EKS Cluster",
      "config": {
        "addons": {
          "coredns": {},
          "eks-pod-identity-agent": {
            "before_compute": true
          },
          "kube-proxy": {},
          "vpc-cni": {
            "before_compute": true
          }
        },
        "cloudwatch_log_group_kms_key_id": "${kms.key_arn}",
        "create_kms_key": false,
        "eks_managed_node_groups": {
          "default": {
            "instance_types": [
              "t3.small"
            ]
          }
        },
        "enable_cluster_creator_admin_permissions": true,
        "encryption_config": {
          "provider_key_arn": "${kms.key_arn}"
        },
        "endpoint_public_access": true,
        "endpoint_public_access_cidrs": [
          "0.0.0.0/0"
        ],
        "kubernetes_version": "1.34"
      },
      "id": "eks",
      "state_key_hint": "tf-native-state/<tenant>/<app>-eks-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-5399078181f2",
      "blueprint_name": "EKS Pod Identity",
      "config": {
        "associations": {
          "lbc": {
            "cluster_name": "${eks.cluster_name}",
            "namespace": "kube-system",
            "service_account": "aws-load-balancer-controller"
          }
        },
        "attach_aws_lb_controller_policy": "<redacted>",
        "name": "aws-lbc"
      },
      "id": "lb_controller_role",
      "state_key_hint": "tf-native-state/<tenant>/<app>-lb_controller_role-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-776697064ac6",
      "blueprint_name": "AWS Load Balancer Controller",
      "config": {
        "clusterName": "${eks.cluster_name}",
        "create_namespace": false,
        "namespace": "kube-system",
        "region": "us-east-1",
        "serviceAccount": {
          "annotations": {
            "archie.io/iam-role": "${lb_controller_role.iam_role_arn}"
          },
          "create": true,
          "name": "aws-load-balancer-controller"
        },
        "vpcId": "${vpc.vpc_id}"
      },
      "id": "lb_controller",
      "state_key_hint": "tf-native-state/<tenant>/<app>-lb_controller-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-b304c19ccb35",
      "blueprint_name": "Deployment",
      "config": {
        "env": {
          "QUOTES_TABLE": "${dynamodb.dynamodb_table_arn}"
        },
        "iam_statements": [
          {
            "actions": [
              "dynamodb:DescribeTable",
              "dynamodb:GetItem",
              "dynamodb:UpdateItem"
            ],
            "resources": [
              "${dynamodb.dynamodb_table_arn}"
            ]
          },
          {
            "actions": [
              "kms:Decrypt",
              "kms:GenerateDataKey"
            ],
            "resources": [
              "${kms.key_arn}"
            ]
          }
        ],
        "image": "${ecr.repository_url}",
        "labels": {
          "archie.io/lb-controller": "${lb_controller.status}"
        },
        "oidc_provider_arn": "${eks.oidc_provider_arn}",
        "service_annotations": {
          "service.beta.kubernetes.io/aws-load-balancer-nlb-target-type": "ip",
          "service.beta.kubernetes.io/aws-load-balancer-scheme": "internet-facing",
          "service.beta.kubernetes.io/aws-load-balancer-type": "external"
        }
      },
      "id": "workload",
      "state_key_hint": "tf-native-state/<tenant>/<app>-workload-<env>/terraform.tfstate",
      "version": "1.0.0"
    }
