        "create_certificate": false,
        "create_route53_records": true,
        "create_route53_records_only": true,
        "distinct_domain_names": "${cert.distinct_domain_names}",
        "tags": {
          "Environment": "sandbox",
          "ManagedBy": "Archie",
          "Owner": "agent@askarchie.io"
        },
        "validation_method": "DNS",
        "zone_id": "Z04127342JQGOUEDW9JAG"
      },
      "id": "cert_validation",
      "state_key_hint": "tf-native-state/<tenant>/<app>-cert_validation-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-f31bf692c566",
      "blueprint_name": "CDN",
      "config": {
        "aliases": "${cert.distinct_domain_names}",
        "default_cache_behavior": {
          "default_ttl": "0",
          "max_ttl": "0",
          "min_ttl": "0",
          "target_origin_id": "application",
          "viewer_protocol_policy": "<redacted>"
        },
        "origin": {
          "application": {
            "domain_name": "${application.lambda_function_url}",
            "origin_access_control_key": "lambda"
          }
        },
        "origin_access_control": {
          "lambda": {
            "description": "CloudFront signs requests to the Lambda function URL",
            "origin_type": "lambda",
            "signing_behavior": "always",
            "signing_protocol": "sigv4"
          }
        },
        "tags": {
          "Environment": "sandbox",
          "ManagedBy": "Archie",
          "Owner": "agent@askarchie.io"
        },
        "viewer_certificate": {
          "acm_certificate_arn": "${cert.acm_certificate_arn}",
          "minimum_protocol_version": "TLSv1.2_2021",
          "ssl_support_method": "sni-only"
        }
      },
      "id": "cdn",
      "state_key_hint": "tf-native-state/<tenant>/<app>-cdn-<env>/terraform.tfstate",
      "version": "1.0.0"
    },
    {
      "blueprint_id": "bp-b73778b410e5",
      "blueprint_name": "DNS Records",
      "config": {
        "records": [
          {
            "alias": {
              "name": "${cdn.cloudfront_distribution_domain_name}",
              "zone_id": "${cdn.cloudfront_distribution_hosted_zone_id}"
            },
            "type": "A"
          }
        ],
        "zone_name": "askarchie.io"
      },
      "id": "dns",
      "state_key_hint": "tf-native-state/<tenant>/<app>-dns-<env>/terraform.tfstate",
      "version": "1.0.0"
    }
