{
  "archie_golden_path": {
    "category": "",
    "description": "A Python request handler served over HTTPS on an address under askarchie.io: a Lambda function with encrypted logs, behind CloudFront with an ACM certificate, and a DNS record in the shared askarchie.io zone. Built from the live app askarchie-quotes, which served on 2026-10-13.",
    "for_when": "A Python web page or small web app that people outside the team will open, and that needs a recognisable address under our own domain that shows as secure in the browser \u2014 campaign pages, partner links, anything going into a newsletter. The application must expose handler(event, context) in handler.py.",
    "id": "gp-public-web-app-on-custom-domain-50f570ec",
    "name": "Public Web App on Custom Domain",
    "not_for": "Not for anything that is not Python 3.12 with entrypoint handler.handler, not for container-only apps, and not for anything that holds state between requests. Not for a domain other than askarchie.io. If a team preview on the raw function URL is enough, use Public Web App instead.",
    "version": "1.0.0"
  },
  "components": [
