        "create_current_version_allowed_triggers": false,
        "create_lambda_function_url": true,
        "handler": "handler.handler",
        "kms_key_arn": "${kms.key_arn}",
        "runtime": "python3.12",
        "s3_kms_key_id": "${kms.key_arn}",
        "tags": {
          "Environment": "sandbox",
          "Owner": "agent@askarchie.io"
        }
      },
