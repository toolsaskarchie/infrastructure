{
  "archie_golden_path": {
    "category": "",
    "description": "A Python request handler on Lambda with encrypted logs, served through CloudFront on an address under askarchie.io with a validated TLS certificate. The DNS and certificate-validation records are written into the askarchie.io zone in askarchie-svc. Built from the live app askarchie-quotes, which served on 2026-10-09.",
    "for_when": "A Python web page or small web app that people outside the team will open, and that has to be on our own domain and show as secure in the browser \u2014 a campaign page, a public preview, a small HTTP service. The application must expose handler(event, context) in handler.py.",
    "id": "gp-public-web-app-on-our-domain-04193b51",
    "name": "Public Web App on Our Domain",
    "not_for": "Not for anything that is not Python 3.12 or whose entrypoint is not handler.handler, not for container-only applications, and not for anything that has to keep state between requests. Not for an internal preview that does not need a domain \u2014 use Public Web App.",
    "version": "1.0.0"
  },
